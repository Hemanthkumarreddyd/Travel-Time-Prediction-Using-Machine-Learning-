   "source": [
    "def plotCorrelationMatrix(df, figsize=(8, 7)):\n",
    "    plt.figure(figsize=figsize)\n",
    "    sns.heatmap(df.corr(), annot=True, cmap='coolwarm', fmt=\"\\\n.2f\")\n",
    "    plt.title('Correlation Matrix')\n",
    "    plt.show()"
   ]
