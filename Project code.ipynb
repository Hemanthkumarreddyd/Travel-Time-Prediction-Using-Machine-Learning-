   "source": [
    "X = data[['x', 'Date', 'StartTime', 'DayOfWeek', 'GoingTo', 'Distance', 'MaxSpeed', 'AvgSpeed', 'AvgMovingSpeed', 'FuelEconomy', 'MovingTime']]\n",
    "y = data['TotalTimeClass']"
   ]
  },
  {
